@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ev: <https://purl.org/NET/c4dm/event.owl#> .
@prefix mo: <http://purl.org/ontology/mo/> .
@prefix ssvrel: <https://w3id.org/ssv/TISMIR/data/release/> .
@prefix ssvrevent: <https://w3id.org/ssv/TISMIR/data/release_event/> .
@prefix tl: <http://purl.org/NET/c4dm/timeline.owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ssvrevent:2008 a mo:ReleaseEvent,
        ev:Event ;
    mo:release ssvrel:2008 ;
    ev:time [ a tl:Instant ;
            tl:atYear "2008"^^xsd:gYear ] .

ssvrel:2008 dcterms:issued "2008" .

