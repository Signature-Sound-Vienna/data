@prefix ev: <https://purl.org/NET/c4dm/event.owl#> .
@prefix mo: <http://purl.org/ontology/mo/> .
@prefix ssvrel: <https://w3id.org/ssv/data/release/> .
@prefix ssvrevent: <https://w3id.org/ssv/data/release_event/> .
