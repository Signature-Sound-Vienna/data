@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ev: <https://purl.org/NET/c4dm/event.owl#> .
@prefix mo: <http://purl.org/ontology/mo/> .
@prefix ssvrel: <https://w3id.org/ssv/data/release/> .
@prefix ssvrevent: <https://w3id.org/ssv/data/release_event/> .
@prefix tl: <http://purl.org/NET/c4dm/timeline.owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ssvrevent:2000 a mo:ReleaseEvent,
        ev:Event ;
    mo:release ssvrel:2000 ;
    ev:time [ a tl:Instant ;
            tl:atYear "2000"^^xsd:gYear ] .

ssvrel:2000 dcterms:issued "2000" .

